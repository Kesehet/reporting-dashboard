{
  "name": "json-parser",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.6.8",
    "chart.js": "^4.4.2",
    "chartjs-plugin-datalabels": "^2.2.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "primeicons": "^6.0.1",
    "primereact": "^10.6.4",
    "python3": "^0.0.1",
    "quill": "^1.3.7",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "react-scripts": "^5.0.1",
    "react-spinners": "^0.15.0",
    "react-xml-parser": "^1.1.8",
    "web-vitals": "^2.1.4",
    "@azure/msal-browser": "^4.25.1",
    "@azure/msal-react": "^3.0.20",
    "xlsx": "0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "test:nocov": "react-scripts test --watchAll=false --env=@happy-dom/jest-environment",
    "test": "react-scripts test --watchAll=false --coverage --env=@happy-dom/jest-environment",
    "test:changed": "react-scripts test  --env=@happy-dom/jest-environment",
    "test:ci": "react-scripts test --watchAll=false --coverage --testTimeout=10000 --env=@happy-dom/jest-environment",
    "test:memory": "react-scripts test --watchAll=false --detectOpenHandles --env=@happy-dom/jest-environment",
    "test:chart-frontend": "react-scripts test --watchAll=false --env=@happy-dom/jest-environment --runInBand --testPathPattern=contracts/chartResponses.contract.test.js",
    "test:charts": "python scripts/run_chart_contracts.py && python -m unittest discover -s tests/contracts -p \"test_*.py\" -v && npm run test:chart-frontend"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@happy-dom/jest-environment": "^14.7.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "file-loader": "^6.2.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-extended": "^4.0.2",
    "jest-fetch-mock": "^3.0.3",
    "miragejs": "^0.1.48"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css|less|scss|sass|svg)$": "<rootDir>/src/__test__/mocks/styleMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!axios)"
    ],
    "restoreMocks": true,
    "coveragePathIgnorePatterns": [
      "<rootDir>/src/__test__/",
      ".test.",
      "src/reportWebVitals.js",
      "<rootDir>/src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80
      }
    },
    "coverageReporters": [
      "json",
      "html",
      "text"
    ]
  }
}
